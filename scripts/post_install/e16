#!/usr/bin/env bash
# ThinkPad E16 Gen2 (AMD) Post-Install Navigator
# Menu-driven entrypoint for audit/apply/verify/rollback operations
# Part of ubuntu-bootstrap

set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
LIB_DIR="$REPO_DIR/scripts/lib"

# Source libraries if available
[[ -f "$LIB_DIR/logging.sh" ]] && source "$LIB_DIR/logging.sh"
[[ -f "$LIB_DIR/version.sh" ]] && source "$LIB_DIR/version.sh"

# Fallback logging if library not available
if ! declare -f log_info >/dev/null 2>&1; then
    log_info() { echo "[INFO] $*"; }
    log_success() { echo "[OK] $*"; }
    log_warning() { echo "[WARN] $*"; }
    log_error() { echo "[ERROR] $*" >&2; }
    log_step() { echo ""; echo "▶ $*"; }
fi

# Colors (TTY only)
if [[ -t 1 ]]; then
    C_RESET='\033[0m'
    C_BOLD='\033[1m'
    C_CYAN='\033[0;36m'
    C_GREEN='\033[0;32m'
    C_YELLOW='\033[1;33m'
    C_RED='\033[0;31m'
    C_BLUE='\033[0;34m'
else
    C_RESET='' C_BOLD='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_BLUE=''
fi

BUNDLE_PATH_FILE="/tmp/post_install_e16g2_amd_bundle_path.txt"

# Get current bundle path if exists
get_bundle_path() {
    if [[ -f "$BUNDLE_PATH_FILE" ]]; then
        cat "$BUNDLE_PATH_FILE"
    else
        echo "(none)"
    fi
}

# Print header
print_header() {
    echo ""
    echo -e "${C_CYAN}═══════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BOLD}  ThinkPad E16 Gen2 (AMD) — Post-Install Navigator${C_RESET}"
    echo -e "${C_CYAN}  Ubuntu 24.04 LTS — Evidence-Based Automation${C_RESET}"
    echo -e "${C_CYAN}═══════════════════════════════════════════════════════════${C_RESET}"
    echo ""
    echo -e "  ${C_BLUE}Current proof bundle:${C_RESET} $(get_bundle_path)"
    echo ""
}

# Print menu
print_menu() {
    echo -e "${C_BOLD}Select an action:${C_RESET}"
    echo ""
    echo -e "  ${C_GREEN}1)${C_RESET} 🔎  Audit       — Read-only baseline evidence capture"
    echo -e "  ${C_GREEN}2)${C_RESET} ⚙️   Apply       — Apply baseline (performance + security + dev tools)"
    echo -e "  ${C_GREEN}3)${C_RESET} 🧩  Add-ons     — Optional third-party repos (OPT-IN flags)"
    echo -e "  ${C_GREEN}4)${C_RESET} 🧪  Verify      — Read-only health check (nonzero on failure)"
    echo -e "  ${C_GREEN}5)${C_RESET} ↩️   Rollback    — Run rollback.sh from current bundle"
    echo -e "  ${C_GREEN}6)${C_RESET} ❌  Exit"
    echo ""
}

# Run audit
run_audit() {
    echo ""
    log_step "Running Audit (read-only evidence capture)..."
    echo ""
    if [[ -x "$SCRIPT_DIR/post_install_e16g2_amd.sh" ]]; then
        "$SCRIPT_DIR/post_install_e16g2_amd.sh"
    else
        log_error "Audit script not found or not executable: $SCRIPT_DIR/post_install_e16g2_amd.sh"
        return 1
    fi
}

# Run apply
run_apply() {
    echo ""
    log_step "Running Apply (baseline changes)..."
    echo ""

    # Check for additional flags
    local flags=()
    echo -e "${C_YELLOW}Optional flags available:${C_RESET}"
    echo "  --enable-zram           Enable ZRAM with conservative defaults"
    echo "  --enable-docker-official  Use Docker official repo (instead of docker.io)"
    echo "  --enable-nodesource     Use NodeSource repo for Node.js"
    echo "  --enable-vscode         Install VS Code from Microsoft repo"
    echo "  --enable-protonvpn      Install ProtonVPN from official repo"
    echo ""
    read -p "Enter flags (space-separated, or press Enter for defaults): " -r user_flags

    if [[ -x "$SCRIPT_DIR/apply_e16g2_amd.sh" ]]; then
        # shellcheck disable=SC2086
        "$SCRIPT_DIR/apply_e16g2_amd.sh" $user_flags
    else
        log_error "Apply script not found or not executable: $SCRIPT_DIR/apply_e16g2_amd.sh"
        return 1
    fi
}

# Show add-ons guidance
show_addons() {
    echo ""
    log_step "Optional Add-ons (OPT-IN only)"
    echo ""
    echo -e "${C_BOLD}Third-party repositories require explicit flags:${C_RESET}"
    echo ""
    echo -e "${C_CYAN}Docker Official:${C_RESET}"
    echo "  ./scripts/post_install/apply_e16g2_amd.sh --enable-docker-official"
    echo "  Risk: External repo; rollback removes repo + reinstalls docker.io"
    echo ""
    echo -e "${C_CYAN}NodeSource (Node.js LTS):${C_RESET}"
    echo "  ./scripts/post_install/apply_e16g2_amd.sh --enable-nodesource"
    echo "  Risk: External repo; rollback removes repo + package"
    echo ""
    echo -e "${C_CYAN}VS Code:${C_RESET}"
    echo "  ./scripts/post_install/apply_e16g2_amd.sh --enable-vscode"
    echo "  Risk: Microsoft repo; rollback removes repo + package"
    echo ""
    echo -e "${C_CYAN}ProtonVPN:${C_RESET}"
    echo "  ./scripts/post_install/apply_e16g2_amd.sh --enable-protonvpn"
    echo "  Risk: ProtonVPN repo; rollback removes repo + package"
    echo ""
    echo -e "${C_CYAN}ZRAM:${C_RESET}"
    echo "  ./scripts/post_install/apply_e16g2_amd.sh --enable-zram"
    echo "  Risk: Low; rollback removes /etc/systemd/zram-generator.conf"
    echo ""
    echo -e "${C_YELLOW}All add-ons are recorded in decisions.json and reversible via rollback.sh${C_RESET}"
    echo ""
}

# Run verify
run_verify() {
    echo ""
    log_step "Running Verify (read-only checks)..."
    echo ""
    if [[ -x "$SCRIPT_DIR/verify_e16g2_amd.sh" ]]; then
        "$SCRIPT_DIR/verify_e16g2_amd.sh"
        local rc=$?
        if (( rc == 0 )); then
            log_success "All verification checks passed"
        else
            log_error "Verification failed with exit code $rc"
        fi
        return $rc
    else
        log_error "Verify script not found or not executable: $SCRIPT_DIR/verify_e16g2_amd.sh"
        return 1
    fi
}

# Run rollback
run_rollback() {
    echo ""
    log_step "Running Rollback..."
    echo ""

    local bundle_path
    bundle_path="$(get_bundle_path)"

    if [[ "$bundle_path" == "(none)" ]]; then
        log_error "No proof bundle found. Run Audit or Apply first."
        return 1
    fi

    local rollback_script="$bundle_path/rollback.sh"

    if [[ ! -f "$rollback_script" ]]; then
        log_error "No rollback.sh found in bundle: $bundle_path"
        log_info "Rollback is only available after running Apply."
        return 1
    fi

    echo -e "${C_YELLOW}WARNING: This will attempt to reverse changes made by Apply.${C_RESET}"
    echo "Rollback script: $rollback_script"
    echo ""
    read -p "Continue? [y/N] " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        bash "$rollback_script"
    else
        log_info "Rollback cancelled."
    fi
}

# Main menu loop
main_menu() {
    while true; do
        print_header
        print_menu

        read -p "Enter choice [1-6]: " -n 1 -r choice
        echo ""

        case "$choice" in
            1) run_audit ;;
            2) run_apply ;;
            3) show_addons ;;
            4) run_verify ;;
            5) run_rollback ;;
            6|q|Q)
                echo ""
                log_info "Exiting. Proof bundle: $(get_bundle_path)"
                exit 0
                ;;
            *)
                log_warning "Invalid choice: $choice"
                ;;
        esac

        echo ""
        read -p "Press Enter to continue..." -r
    done
}

# Handle --help
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<EOF
ThinkPad E16 Gen2 (AMD) Post-Install Navigator

USAGE:
    $0              Interactive menu
    $0 --help       Show this help

DIRECT SCRIPT ACCESS:
    scripts/post_install/post_install_e16g2_amd.sh   Audit (read-only)
    scripts/post_install/apply_e16g2_amd.sh          Apply baseline
    scripts/post_install/verify_e16g2_amd.sh         Verify (read-only)

OPTIONAL FLAGS (for apply script):
    --enable-zram            Enable ZRAM with conservative defaults
    --enable-docker-official Use Docker official repo
    --enable-nodesource      Use NodeSource for Node.js
    --enable-vscode          Install VS Code
    --enable-protonvpn       Install ProtonVPN

PROOF BUNDLE:
    Each run creates: \$HOME/ubuntu-bootstrap/proof/post_install_e16g2_amd_<UTC_TS>/
    Contains: logs/, report.json, report.txt, CERTIFICATION.txt, decisions.json,
              evidence_index.txt, rollback.sh

EOF
    exit 0
fi

# Run menu
main_menu
